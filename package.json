{
  "name": "dsh-pet-ledger",
  "version": "0.1.0",
  "engines": { "dsh": ">=0.2.1-rc.2 <0.3.0" },
  "description": "A DeepSeek Harness pet whose achievements are earned only from real session events — failure streaks, long turns, red-to-green tests, commit+push — each with the session and tool-call evidence, and demo runs watermarked.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "prepack": "node scripts/build.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "pet",
    "achievements",
    "ledger",
    "evidence",
    "local-first"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dingchenhui0618-arch/dsh-pet-ledger.git"
  },
  "homepage": "https://github.com/dingchenhui0618-arch/dsh-pet-ledger#readme",
  "bugs": {
    "url": "https://github.com/dingchenhui0618-arch/dsh-pet-ledger/issues"
  },
  "license": "MIT"
}
